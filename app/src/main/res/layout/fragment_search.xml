<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Fragment.SearchFragment">

        <EditText
            android:id="@+id/editTextSearchHome"
            android:layout_width="318dp"
            android:layout_height="60dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"
            android:hint="What do you want to order?"
            android:background="@drawable/edittextshape"
            android:drawableLeft="@drawable/icon_search"
            android:paddingLeft="16dp"
            android:drawablePadding="10dp"
            android:elevation="13dp"
            android:ems="20"

            />
        <TextView
            android:layout_width="67dp"
            android:layout_height="30dp"
            android:id="@+id/textViewMenu"
            android:text="Menu"
            app:layout_constraintTop_toBottomOf="@id/editTextSearchHome"
            app:layout_constraintStart_toStartOf="@id/editTextSearchHome"
            app:layout_constraintEnd_toEndOf="@id/editTextSearchHome"
            android:layout_marginTop="20dp"
            android:textSize="24dp"
            android:fontFamily="sans-serif-medium"

            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cartRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/textViewMenu"
            android:layout_marginTop="12dp"
            android:elevation="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="50dp">

        </androidx.recyclerview.widget.RecyclerView>
</androidx.constraintlayout.widget.ConstraintLayout>